#!/bin/bash
# .git/hooks/post-commit — auto-updates STATUS.md, no manual step needed

if [ -n "$STATUS_HOOK_RUNNING" ]; then exit 0; fi
export STATUS_HOOK_RUNNING=1

STATUS_FILE="STATUS.md"
COMMIT_MSG=$(git log -1 --pretty=%s)
DATE=$(date +%Y-%m-%d)

if [ -f "$STATUS_FILE" ]; then
  if grep -q "^- Last worked:" "$STATUS_FILE"; then
    sed -i.bak "s|^- Last worked:.*|- Last worked: $DATE — $COMMIT_MSG|" "$STATUS_FILE"
    rm -f "$STATUS_FILE.bak"
  fi
  git add "$STATUS_FILE"
  git commit -m "chore: update STATUS.md [auto]" --no-verify
fi
